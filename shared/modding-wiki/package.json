{
  "name": "socom-legacy-modding-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "The SOCOM Legacy modding wiki: a static Fumadocs site, outside the npm workspace (B205, MW.R2-R3)",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-theme.mjs",
    "dev": "node scripts/run-next.mjs dev --port 5330 --hostname localhost",
    "build": "node scripts/run-next.mjs build",
    "check": "npm run build && node scripts/check-out.mjs && node scripts/check-search.mjs",
    "check:out": "node scripts/check-out.mjs",
    "check:search": "node scripts/check-search.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
