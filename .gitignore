/server/horizon-docker/
/server/horizon-server-database-middleware/

# The npm workspace at the root since 2026-10-02 (the restructure's step 7 dropped the web/ level, RS.R4): socomlegacy/
# (the map viewer and its server), landing/ (socomunzipped.com), shared/ (the design system). Dependencies, builds,
# and game data extracted from the owner's disc or rendered from it; the landing build makes its game-derived files
# from the disc and docs/story at build time. (Merged from the old .gitignore.)
node_modules/
dist/
*.tsbuildinfo
/socomlegacy/public/maps/
# The player's ISO laid out for extract-maps, and the path workflow/test-disc.ps1 remembers. Never committed.
/socomlegacy/.disc/
/socomlegacy/.local/
# Local experimental texture packs: generated from owner assets, never uploaded or committed.
/socomlegacy/public/experimental-packs/
/socomlegacy/public/startup/
# RS.R8's size policy (MISSION "Game data in git"; adopted, the owner confirmed it 2026-10-02, H71): the manifest is
# tracked; the disc files it lists as committed are un-ignored BY NAME by the data commit that added them
# (data(fixtures): ...), so a disc file the manifest does not list stays out
# (socomlegacy/tools/test/fixtureManifest.test.ts holds the manifest, git's tracked set and these lines together).
# Everything else under test-fixtures/ stays out: any RUN/ file the manifest does not list, the local-only files by
# name, and what the specs and tools write there (screens/, sounds/, textures/, a glTF export). The local-only lines
# repeat what the broad rules already ignore, on purpose, after the last un-ignore: a file over the cap stays out if a
# broad rule is narrowed (the manifest test refuses a local-only file without its line).
/socomlegacy/test-fixtures/*
!/socomlegacy/test-fixtures/MANIFEST.json
# The data commit's lines: RUN/'s directories walked, its files ignored but the committed tier's 20, by name.
!/socomlegacy/test-fixtures/RUN/
/socomlegacy/test-fixtures/RUN/**
!/socomlegacy/test-fixtures/RUN/**/
!/socomlegacy/test-fixtures/RUN/IRX/LIBSD.IRX
!/socomlegacy/test-fixtures/RUN/LOCALE/STATES/UIMNLOC.ZAR
!/socomlegacy/test-fixtures/RUN/MOTION_P.ZAR
!/socomlegacy/test-fixtures/RUN/MP2.ZDB
!/socomlegacy/test-fixtures/RUN/MP6.ZDB
!/socomlegacy/test-fixtures/RUN/MP72.ZDB
!/socomlegacy/test-fixtures/RUN/MPZANIM.ZAR
!/socomlegacy/test-fixtures/RUN/READERC.ZAR
!/socomlegacy/test-fixtures/RUN/SOUNDRDR.ZAR
!/socomlegacy/test-fixtures/RUN/UI/JUNK_TXR.ZED
!/socomlegacy/test-fixtures/RUN/UI/READERC.ZAR
!/socomlegacy/test-fixtures/RUN/UI/UI.ZED
!/socomlegacy/test-fixtures/RUN/UI/UIMP_PAL.ZED
!/socomlegacy/test-fixtures/RUN/UI/UIMP_TXR.ZED
!/socomlegacy/test-fixtures/RUN/UI/UI_GEO.ZED
!/socomlegacy/test-fixtures/RUN/UI/UI_MDL.ZED
!/socomlegacy/test-fixtures/RUN/UI/UI_PAL.ZED
!/socomlegacy/test-fixtures/RUN/UI/UI_TXR.ZED
!/socomlegacy/test-fixtures/RUN/UIZANIM.ZAR
!/socomlegacy/test-fixtures/RUN/ZWEAPON.ZAR
# RV2-00's recorded replay (the manifest's replay/ entry, recorded by a real Room, not a disc file): replay/ walked, its
# files ignored but this one, by name.
!/socomlegacy/test-fixtures/replay/
/socomlegacy/test-fixtures/replay/**
!/socomlegacy/test-fixtures/replay/mp2-classic-two-rounds.s2r
/socomlegacy/test-fixtures/RUN/SOUNDS/BNKSTORE.ZAR
/socomlegacy/test-fixtures/iso/frostfire-only.iso
/socomlegacy/test-fixtures/iso/frostfire-flylock.iso
test-results/
playwright-report/
