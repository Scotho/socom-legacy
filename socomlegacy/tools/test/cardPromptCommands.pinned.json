    "IF memcard_have_loaded_config == 0",
    "  VALVE KeepTryingMemcardLoad = 1",
    "  WHILE KeepTryingMemcardLoad == 1",
    "    VALVE KeepTryingMemcardLoad = 0",
    "    IF memcard_already_selected == 0",
    "      CALL find_a_memcard (blocking)",
    "    ENDIF",
    "    IF IsMemCardInserted(NA)",
    "      IF NOT ( IsMemCardFormatted(NA) ) AND IsMemCardInserted(NA)",
    "        VALVE NotDone = 1",
    "        WHILE NotDone == 0 AND IsMemCardInserted(NA) AND NOT ( IsMemCardFormatted(NA) )",
    "          CALL AskToFormat (blocking)",
    "          IF IsMemCardInserted(NA) AND NOT ( IsMemCardFormatted(NA) )",
    "            IF AreYouSure != 1",
    "              CALL AreYouSureYouWantToFormat (blocking)",
    "              IF AreYouSure != 1 AND IsMemCardInserted(NA) AND NOT ( IsMemCardFormatted(NA) )",
    "                CALL do_formatting (blocking)",
    "                VALVE MemcardGotFormatted = 1",
    "                VALVE NotDone = 1",
    "              ENDIF",
    "            ELSE",
    "              CALL AreYouSureYouDontWantToFormat (blocking)",
    "              IF AreYouSure == 1",
    "                VALVE NotDone = 1",
    "              ENDIF",
    "            ENDIF",
    "          ENDIF",
    "        END_WHILE",
    "      ENDIF",
    "      IF IsMemCardFormatted(NA)",
    "        CALL DisplayLoadingWarning (blocking)",
    "        VALVE MemcardAlreadyHasData = 0",
    "        CALL Ensure_MC_Dirs_Fast (blocking)",
    "        IF MemcardAlreadyHasData == 0 AND IsMemCardInserted(NA)",
    "          IF IsSpaceForSaveGameFile(NA)",
    "            CALL NoSOCOMDataFound2 (blocking)",
    "          ELSE",
    "            CALL CannotSaveNoSpace (blocking)",
    "          ENDIF",
    "        ELSE",
    "          VALVE memcard_error = 0",
    "          LoadConfig(BASCUS-97275SOCOMII)",
    "          ListSavedGames(NA)",
    "          WAIT 0.3",
    "          IF memcard_error == 1",
    "            CALL DisplayErrorLoading (blocking)",
    "          ELSE",
    "            IF video_mode == 1",
    "              IF NOT CheckVideoMode(DTV)",
    "                CALL SwitchToProgressiveVideo (blocking)",
    "              ENDIF",
    "            ENDIF",
    "          ENDIF",
    "        ENDIF",
    "      ELSE",
    "        VALVE AcceptNoData = 0",
    "        POPUPDIALOG(NA)",
    "        IF MainMenuCardSlot == 0",
    "          POPUP <text 137> buttons #226 -> AcceptNoData",
    "        ELSE",
    "          POPUP <text 137> buttons #226 -> AcceptNoData",
    "        ENDIF",
    "        WHILE AcceptNoData == 0",
    "        END_WHILE",
    "      ENDIF",
    "    ELSE",
    "      VALVE AcceptNotInserted = 0",
    "      STOP menu_fade_up",
    "      OPACITY MENUFADER 0->0.7 0.05",
    "      VALVE AcceptNotInserted = 0",
    "      POPUPDIALOG(NA)",
    "      IF memcard_already_selected == 1",
    "        IF MainMenuCardSlot == 0",
    "          POPUP <text 72> buttons #226 -> AcceptNotInserted",
    "        ELSE",
    "          POPUP <text 72> buttons #226 -> AcceptNotInserted",
    "        ENDIF",
    "        WHILE AcceptNotInserted == 0",
    "        END_WHILE",
    "        VALVE KeepTryingMemcardLoad = 0",
    "      ELSE",
    "        POPUP #826 buttons #246/#253 -> AcceptNotInserted",
    "        WHILE AcceptNotInserted == 0",
