    "          VALVE NotDone = 1",
    "          CALL_SEQUENCE end_of_screen",
    "        ENDIF",
    "      ENDIF",
    "    END_WHILE",
    "  ELSE",
    "    IF NOT IsSpaceForSaveGameFile(NA)",
    "      POPUPDIALOG(NA)",
    "      VALVE SitHere = 0",
    "      POPUP #823 buttons #226 -> SitHere",
    "      WHILE SitHere == 0",
    "      END_WHILE",
    "    ENDIF",
    "    CALL_SEQUENCE end_of_screen",
