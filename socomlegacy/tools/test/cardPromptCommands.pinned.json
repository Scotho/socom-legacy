    "            IF IsMemCardInserted(NA) AND NOT ( IsMemCardFormatted(NA) )",
    "              IF AreYouSure != 1",
    "                CALL AreYouSureYouWantToFormat (blocking)",
    "                IF AreYouSure != 1 AND IsMemCardInserted(NA) AND NOT ( IsMemCardFormatted(NA) )",
    "                  CALL do_formatting (blocking)",
    "                  VALVE MemcardGotFormatted = 1",
    "                  VALVE NotDone = 1",
    "                ENDIF",
    "              ELSE",
    "                CALL AreYouSureYouDontWantToFormat (blocking)",
    "                IF AreYouSure == 1",
    "                  VALVE NotDone = 1",
    "                  VALVE SaveConcluded = 0",
    "                ENDIF",
    "              ENDIF",
    "            ENDIF",
    "          END_WHILE",
    "        ENDIF",
    "        CALL Ensure_MC_Dirs_Fast (blocking)",
    "        IF IsMemcardSaveOK(NA)",
    "          IF IsSpaceForSaveGameFile(NA)",
    "            VALVE MemcardAlreadyHasData = 0",
    "            CALL Ensure_MC_Dirs_Fast (blocking)",
    "            VALVE ShouldContinue = 1",
    "            IF MemcardAlreadyHasData == 1 AND MemcardGotFormatted == 0",
    "              VALVE AreYouSure = 0",
    "              CALL AskToOverwrite",
    "              WHILE AreYouSure == 0",
    "                IF NOT IsMemCardInserted(NA)",
    "                  CALL CannotSaveNoMemcard (blocking)",
    "                  VALVE AreYouSure = 1",
    "                ENDIF",
    "                WAIT 0.1",
    "              END_WHILE",
    "              IF AreYouSure == 1",
    "                VALVE ShouldContinue = 0",
    "                VALVE SaveConcluded = 0",
    "              ENDIF",
    "            ENDIF",
    "            IF ShouldContinue == 1",
    "              POPUPDIALOG(NA)",
    "              IF MainMenuCardSlot == 0",
    "                POPUP #834 keep",
    "              ELSE",
    "                POPUP #835 keep",
    "              ENDIF",
    "              WAIT 0.2",
    "              VALVE memcard_error = 0",
    "              VALVE MemcardAlreadyHasData = 0",
    "              CALL Ensure_MC_Dirs (blocking)",
    "              IF MemcardAlreadyHasData == 1",
    "                SaveConfig(BASCUS-97275SOCOMII)",
    "              ENDIF",
    "              WAIT 0.2",
    "              IF memcard_error == 1",
    "                VALVE SaveConcluded = 0",
    "                CALL DisplayErrorSaving (blocking)",
    "              ENDIF",
    "              KILLPOPUP(NA)",
    "              OPACITY MENUFADER 0.7->0 0.05",
    "            ENDIF",
    "          ELSE",
    "            CALL CannotSaveNoSpace (blocking)",
    "            VALVE DoneSaving = 1",
    "            VALVE SaveConcluded = 0",
    "          ENDIF",
    "        ELSE",
    "          IF memcard_error_code == 1",
    "            CALL CannotSaveNotFormatted (blocking)",
    "          ELSEIF memcard_error_code == 2",
    "            CALL CannotSaveNoMemcard (blocking)",
    "          ELSEIF NOT ( IsSpaceForSaveGameFile(NA) )",
    "            CALL CannotSaveNoSpace (blocking)",
    "          ENDIF",
    "          VALVE SaveConcluded = 0",
    "        ENDIF",
    "      ELSE",
    "        CALL CannotSaveNoMemcard (blocking)",
    "        VALVE SaveConcluded = 0",
    "      ENDIF",
    "    ENDIF",
    "  END_WHILE",
    "  IF ShouldLeaveOnSaveAndLeave == 0",
    "    IF MultiplayerDisconnectFromOptions == 0",
    "      IF CameFromNewGameButton == 1",
    "        VALVE uiEquipReturnScreen = 51",
    "        SWITCHMENU(dlgAlbaniaCinematic.rdr)",
    "        VALVE CameFromNewGameButton = 0",
    "      ELSE",
    "        SWITCHMENU(PREVIOUS_SCREEN)",
    "      ENDIF",
    "    ENDIF",
    "  ENDIF",
    "ENDIF",
    "CALL has_memcard_changed"
   ],
